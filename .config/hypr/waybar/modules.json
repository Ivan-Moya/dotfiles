{
  "battery": {
    "bat": "BAT0",
    "format": "{icon}<span size='10pt'><b>{capacity}</b></span>",
    "format-critical": "<span font='JetBrainsMono Nerd Font' color='#f38ba8'>{icon}</span><small><b>{capacity}</b></small>",
    "format-good": "<span font='JetBrainsMono Nerd Font' color='#a6e3a1'>{icon}</span><small><b>{capacity}</b></small>",
    "format-icons": ["", "", "", "", ""], // Simplified to single icons
    "format-time": "{H}hr & {m}min",
    "format-warning": "<span font='JetBrainsMono Nerd Font' color='#f9e2af'>{icon}</span><small><b>{capacity}</b></small>",
    "interval": 60,
    "max-length": 25,
    "states": {
      "critical": 15,
      "good": 100,
      "warning": 30
    },
    "tooltip-format": "{time} at {capacity}% ({power}W)",
    "tooltip-format-charging": "{time} (� nekcharging), at {capacity}%",
    "tooltip-format-discharging": "{time} (󱧦 discharging), at {capacity}%"
  },

  "custom/appmenu": {
    "format": "󰣇 ",
    "on-click": "rofi -show drun -theme ~/.config/hypr/rofi/launcher.rasi",
    "on-click-right": "~/.config/hypr/scripts/keybindings.sh",
    "tooltip-format": "Left: Open the application launcher\nRight: Show all keybindings"
  },

  "bluetooth": {
    "format": " {status}",
    "format-disabled": "",
    "format-off": "",
    "interval": 30,
    "on-click": "blueman-manager",
    "format-no-controller": ""
  },

  "clock#date": {
    "actions": {
      "on-scroll-down": "shift_down",
      "on-scroll-up": "shift_up"
    },
    "calendar": {
      "format": {
        "days": "<span weight='normal'>{}</span>",
        "months": "<span color='#cdd6f4'><b>{}</b></span>",
        "today": "<span color='#f38ba8' weight='700'><u>{}</u></span>",
        "weekdays": "<span color='#f9e2af'><b>{}</b></span>",
        "weeks": "<span color='#a6e3a1'><b>W{}</b></span>"
      },
      "mode": "month",
      "mode-mon-col": 1,
      "on-scroll": 1,
      "weeks-pos": "right"
    },
    "format": "{:%A, %b %e}",
    "interval": 43200,
    "tooltip-format": "<span color='#cdd6f4' font='Roboto Mono 14'><small>{calendar}</small></span>"
  },

  "clock#time": {
    "format": "{:%I<small><span color='#9399b2'>:</span></small>%M<span size='4pt'> </span><span weight='bold' size='10pt' color='#9399b2'>%p</span>}",
    "interval": 60
  },

  "hyprland/window": {
    "rewrite": {
      "(.*) - Firefox": "$1",
      "(.*) - Chromium": "$1",
      "(.*) - Brave Search": "$1",
      "(.*) - Thunderbird": "$1",
      "(.*) Okular": "$1"
    },
    "separate-outputs": true
  },

  "group/brightness": {
    "drawer": {
      "children-class": "backlight",
      "transition-duration": 500,
      "transition-left-to-right": true
    },
    "modules": ["backlight", "backlight/slider"],
    "orientation": "horizontal"
  },

  "group/clock": {
    "modules": ["clock#time", "clock#date"],
    "orientation": "inherit"
  },

  "group/sys-info": {
    "modules": [
      "network",
      "network#bandwidth",
      "bluetooth",
      "group/volume",
      "group/brightness"
    ],
    "orientation": "horizontal"
  },

  "group/volume": {
    "drawer": {
      "children-class": "pulseaudio",
      "transition-duration": 500,
      "transition-left-to-right": true
    },
    "modules": ["pulseaudio", "pulseaudio/slider"],
    "orientation": "horizontal"
  },

  "hyprland/workspaces": {
    "active-only": false,
    "all-outputs": true,
    "format": "{icon} {name}",
    "format-icons": {
      "1": "", // Code
      "2": "", // Terminal
      "3": "", // Bug
      "4": "", // Web
      "5": "", // Vim/Neovim
      "6": "", // Linux
      "7": "", // Database
      "8": "", // Git
      "9": "", // Tools
      "default": "",
      "persistent": "",
      "special": ""
    },
    "on-scroll-down": "hyprctl dispatch workspace e+1",
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "persistent-workspaces": {
      "*": 5
    }
  },

  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 18,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": ["Alacritty"],
    "app_ids-mapping": {
      "firefoxdeveloperedition": "firefox"
    },
    "rewrite": {
      "Firefox Web Browser": "Firefox",
      "Foot Server": "Terminal"
    }
  },

  "mpd": {
    "interval": 2,
    "unknown-tag": "unknown",
    "format": "{stateIcon} {artist} - {title}",
    "format-disconnected": " Disconnected",
    "format-paused": "{stateIcon} {artist} - {title}",
    "format-stopped": "Stopped ",
    "state-icons": {
      "paused": " ",
      "playing": " ",
      "next": "n",
      "prev": "p"
    },
    "tooltip-format": "MPD (connected)",
    "tooltip-format-disconnected": "MPD (disconnected)",
    "on-click": "mpc toggle",
    "on-click-middle": "mpc prev",
    "on-click-right": "mpc next",
    "on-update": "",
    "on-scroll-up": "mpc seek +00:00:01",
    "on-scroll-down": "mpc seek -00:00:01",
    "smooth-scrolling-threshold": 1
  },

  "network": {
    "format": "{icon}",
    "format-disconnected": "󰖪",
    "format-ethernet": "󰈀/{cidr}",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-linked": "󰖩",
    "format-wifi": "{icon}",
    "interval": 30,
    "on-click": "nm-connection-editor",
    "on-click-right": "rfkill toggle wifi",
    "tooltip": true,
    "tooltip-format": "interface:\t{ifname}\n\nconnected to {essid} at {signalStrength}% strength",
    "tooltip-format-disconnected": "interface: {ifname}\nnot connected"
  },

  "network#bandwidth": {
    "format": " {bandwidthDownBits}  {bandwidthUpBits}",
    "format-disconnected": "󰖪",
    "format-ethernet": " {bandwidthDownBits}  {bandwidthUpBits}",
    "format-linked": "󰈁",
    "format-wifi": " {bandwidthDownBits}  {bandwidthUpBits}",
    "interval": 1,
    "tooltip": true,
    "tooltip-format": "{ifname}\nDown: {bandwidthDownBits}\nUp: {bandwidthUpBits}",
    "tooltip-format-disconnected": "interface: {ifname}\nnot connected"
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-bluetooth": "{icon}",
    "format-icons": {
      "default": ["󰕿", "", "󰕾"]
    },
    "format-muted": "󰖁",
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute 0 toggle",
    "scroll-step": 1,
    "tooltip-format": "{desc}\t{icon}{volume}%"
  },

  "pulseaudio/slider": {
    "max": 100,
    "min": 0,
    "orientation": "horizontal",
    "expand": false
  },

  "tray": {
    "icon-size": 20,
    "spacing": 5
  },

  "backlight": {
    "device": "intel_backlight",
    "format": "{icon}",
    "tooltip-format": "{icon}{percent}%",
    "format-icons": ["󰃞", "󰃝", "󰃟", "󰃠"]
  },

  "backlight/slider": {
    "max": 100,
    "min": 0,
    "orientation": "horizontal",
    "device": "intel_backlight"
  },

  "custom/power-menu": {
    "format": "",
    "on-click": "wlogout",
    "tooltip": false
  },

  "image": {
    "tooltip": false,
    "path": "/home/ivan/.config/waybar/avatar.png",
    "size": 47
  },

  "custom/keyboard": {
    "format": "󰌌 {}",
    "return-type": "json",
    "exec": "/home/ivan/.config/hypr/scripts/toggle-keyboard.sh",
    "signal": 8,
    "on-click": "/home/ivan/.config/hypr/scripts/toggle-keyboard.sh --toggle && pkill -RTMIN+8 waybar"
  },

  "custom/updates": {
    "format": "   {}",
    "escape": true,
    "return-type": "json",
    "exec": "/home/ivan/.config/hypr/scripts/updates.sh",
    "restart-interval": 60,
    "on-click": "kitty --class dotfiles-floating -e /home/ivan/.config/hypr/scripts/installupdates.sh",
    "on-click-right": "/home/ivan/.config/hypr/scripts/software.sh"
  },

  "custom/pacman": {
    "format": " {} update available",
    "exec": "checkupdates | wc -l",
    "exec-if": "test $(checkupdates | wc -l) -ne 0",
    "interval": 3600,
    "on-click": "ktty -e sudo pacman -Syu"
  }
}
